<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Decorative Header Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_badge_primary"
                android:fontFamily="@font/cairo_bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="رسائل وبشائر قرآنية"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Quote / Message Text -->
            <TextView
                android:id="@+id/rsael_item_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:fontFamily="@font/qumsg"
                android:gravity="center"
                android:lineSpacingExtra="8dp"
                android:paddingHorizontal="8dp"
                android:textIsSelectable="true"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="رسالة قرآنية مباركة تؤنس قلبك..." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider_color" />

            <!-- Action Bar Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/qumsgrate"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="star_circle"
                    app:materialIconColor="@color/gold_accent"
                    app:materialIconSize="28dp" />

                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/qumsgcopy"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="content_copy"
                    app:materialIconColor="@color/colorAccent"
                    app:materialIconSize="26dp" />

                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/qumsgshare"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="share_variant"
                    app:materialIconColor="@color/colorPrimary"
                    app:materialIconSize="28dp" />

                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/qumsgwhats"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="whatsapp"
                    app:materialIconColor="#25D366"
                    app:materialIconSize="28dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
