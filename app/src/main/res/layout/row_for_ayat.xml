<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_ayat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/quran_page_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/arabicView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jazeera"
        android:gravity="end"
        android:lineSpacingExtra="10dp"
        android:padding="8dp"
        android:text="بسم الله"
        android:textColor="@color/quran_text_color"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/paraAndPageNoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/paraAndPageNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/flat5"
            android:gravity="center"
            android:padding="4dp"
            android:text="30/610"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/bookmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:fontFamily="@font/flat5"
        android:text="آخر قراءة"
        android:textColor="@color/gold_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/divider_color" />

</LinearLayout>
