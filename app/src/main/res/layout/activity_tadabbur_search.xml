<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".tadabbur.ui.TadabburSearchActivity">

    <!-- Search Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        app:titleCentered="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:navigationIcon="@drawable/ic_back_button"
        app:title="البحث الشامل في القرآن وعلومه"
        app:titleTextAppearance="@style/TitleBarTextAppearance"
        app:titleTextColor="@color/text_white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Search Input Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/search_input_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                app:tint="@color/colorPrimary" />

            <EditText
                android:id="@+id/et_search_query"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/ffon1"
                android:hint="اكتب كلمة، نص آية، إعراب أو تفسير..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_clear_query"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_baseline_close_24"
                android:visibility="gone"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Search Scope Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_scope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_scope_all"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="@font/ffon1"
                    android:text="الكل" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_scope_ayah"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ffon1"
                    android:text="نص الآيات" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_scope_tafseer"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ffon1"
                    android:text="التفاسير" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_scope_earab"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ffon1"
                    android:text="إعراب القرآن" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_scope_maany"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ffon1"
                    android:text="المعاني" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Search Results Counter Label -->
        <TextView
            android:id="@+id/tv_search_results_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/ffon1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="نتائج البحث (25 نتيجة)" />

        <!-- Search Progress Loading Bar -->
        <ProgressBar
            android:id="@+id/progress_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:visibility="gone" />

        <!-- Search Results RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_tadabbur_search_result" />

        <!-- Empty Search State -->
        <LinearLayout
            android:id="@+id/layout_search_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_search_empty_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/ffon1"
                android:gravity="center"
                android:text="ادخل كلمة أو نصًا في صندوق البحث أعلاه للبدء"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
