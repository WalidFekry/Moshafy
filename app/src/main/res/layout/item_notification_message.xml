<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Message Index -->
            <LinearLayout
                android:id="@+id/messageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jazeera"
                    android:text="@string/message_num"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMessageNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="@color/chip_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/message_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jazeera"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/colorPrimary"
                        android:textSize="13sp"
                        tools:text="1" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Message Time -->
            <LinearLayout
                android:id="@+id/timeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jazeera"
                    android:text="@string/message_time"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMessageTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="@color/chip_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/message_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jazeera"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="12:00 AM" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Lottie Decor Animation -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animation_view"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/messageInfo"
                app:lottie_autoPlay="true"
                app:lottie_fileName="data.json"
                app:lottie_loop="false" />

            <!-- Quote Text -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ffon1"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:padding="8dp"
                android:text="نص الرسالة"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/animation_view" />

            <!-- Divider -->
            <View
                android:id="@+id/item_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/divider_color"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title" />

            <!-- Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_divider">

                <!-- Save / Bookmark Quote -->
                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/starquran"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="bookmark_outline"
                    app:materialIconColor="@color/gold_accent"
                    app:materialIconSize="28dp" />

                <!-- Share Quote as Image -->
                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/share_image"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="image"
                    app:materialIconColor="@color/colorPrimary"
                    app:materialIconSize="28dp" />

                <!-- Download Quote Image to Gallery -->
                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/download_image"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="download"
                    app:materialIconColor="@color/colorPrimary"
                    app:materialIconSize="28dp" />

                <!-- Copy Text -->
                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/copyquran"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="content_copy"
                    app:materialIconColor="@color/colorAccent"
                    app:materialIconSize="26dp" />

                <!-- WhatsApp Share Text -->
                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/qumsgwhats"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="whatsapp"
                    app:materialIconColor="#25D366"
                    app:materialIconSize="28dp" />

                <!-- Facebook Share Text -->
                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/facebook_share"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="center"
                    app:materialIcon="facebook_box"
                    app:materialIconColor="#1877F2"
                    app:materialIconSize="28dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
