<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Ayah Card View -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_ayah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Uthmani Ayah Text -->
            <TextView
                android:id="@+id/tv_ayah_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/uthmanii"
                android:lineSpacingExtra="10dp"
                android:layout_gravity="end"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textColor="@color/quran_text_color"
                android:textSize="22sp"
                tools:text="الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:background="@color/card_stroke" />

            <!-- Ayah Action Bar (Tafseer, Bookmark, Copy, Share) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ayah_info_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_primary"
                    android:fontFamily="@font/ffon1"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    tools:text="آية 1" />

                <TextView
                    android:id="@+id/tv_sajdah_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/sajdah_badge_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="۩ سجدة تلاوة"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Action: Open Tafseer & Details -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_details"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:fontFamily="@font/jazeera"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="عرض التفسير"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    app:iconSize="16dp"
                    app:iconTint="@color/colorPrimary" />

                <!-- Action: Bookmark -->
                <ImageView
                    android:id="@+id/btn_bookmark"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="حفظ الآية"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/colorPrimary" />

                <!-- Action: Copy -->
                <ImageView
                    android:id="@+id/btn_copy"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="نسخ الآية"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_content_copy"
                    app:tint="@color/text_secondary" />

                <!-- Action: Share -->
                <ImageView
                    android:id="@+id/btn_share"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="مشاركة الآية"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
