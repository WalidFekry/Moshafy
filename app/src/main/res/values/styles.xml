<resources>

    <!-- Base application theme with DayNight support -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize theme colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/bg_main</item>

        <!-- Custom attributes mappings -->
        <item name="bg">@color/bg_main</item>
        <item name="cardViewBackground">@color/card_bg</item>
        <item name="primaryTextColor">@color/text_primary</item>
        <item name="SecondaryTextColor">@color/text_secondary</item>
        <item name="btn_bg">@color/colorPrimary</item>
        <item name="mainItemsColor">@color/colorPrimary</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <style name="reportContentText">
        <item name="android:fontFamily">@font/flat5</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_below">@id/drawer_layout</item>
    </style>

    <style name="TextAppearance.AllTextView" parent="android:TextAppearance">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TitleToolBarApppearance" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/ffon1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_gravity">end</item>
    </style>

    <style name="TextAppearance.MyApp.Title.QiblahActivity" parent="android:TextAppearance">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:fontFamily">@font/lmonada</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TitleBarTextAppearance" parent="android:TextAppearance">
        <item name="android:title">القرآن</item>
        <item name="android:fontFamily">@font/jazeera</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_white</item>
    </style>

</resources>
